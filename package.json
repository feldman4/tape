{
  "name": "tape-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:tape",
    "dev:tape": "npm run dev --workspace=tape",
    "dev:loop-pad": "npm run dev --workspace=loop-pad",
    "build": "npm run build --workspaces --if-present",
    "build:tape": "npm run build --workspace=tape",
    "build:loop-pad": "npm run build --workspace=loop-pad",
    "lint": "npm run lint --workspaces --if-present",
    "lint:tape": "npm run lint --workspace=tape",
    "lint:loop-pad": "npm run lint --workspace=loop-pad",
    "test:hardware:setup": "npm run test:hardware:setup --workspace=tape",
    "test:hardware": "npm run test:hardware --workspace=tape",
    "test:workflow": "npm run test:workflow --workspace=tape",
    "test:control-mode": "npm run test:control-mode --workspace=tape"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}